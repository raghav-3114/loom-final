# Loom AI Environment Variables Example

# OpenRouter is the default provider. Never commit a real key.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Server Configuration
PORT=3001
DATABASE_PATH=./apps/server/loom.db

# AI provider and model configuration
ROUTER_PROVIDER=openrouter
ROUTER_MODEL=qwen/qwen3-coder-flash
PLANNER_PROVIDER=openrouter
PLANNER_MODEL=qwen/qwen3-coder-flash
BUILDER_PROVIDER=openrouter
BUILDER_MODEL=qwen/qwen3-coder-flash
# Maximum completion length for complex multi-file projects.
BUILDER_MAX_TOKENS=16384
REVIEWER_PROVIDER=openrouter
REVIEWER_MODEL=qwen/qwen3-coder-flash
